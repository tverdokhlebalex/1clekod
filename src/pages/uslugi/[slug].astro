---
import { render } from "astro:content";
import ServicePage from "@/components/sections/ServicePage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getHome, getServices, getSite, getTariffs, metrikaId } from "@/lib/content";
import { withBase } from "@/lib/path";

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.data.slug } }));
}

const { slug } = Astro.params;
const services = await getServices();
const service = services.find((item) => item.data.slug === slug);
if (!service) {
  throw new Error(`Услуга не найдена: ${slug}`);
}
const { Content } = await render(service);
const site = getSite();
const home = getHome();
const tariffs = getTariffs();
const origin = Astro.site ?? new URL(site.url);
const canonical = new URL(withBase(`/uslugi/${service.data.slug}`), origin).href;
const related = services.map((item) => ({
  slug: item.data.slug,
  title: item.data.title,
  outcome: item.data.outcome,
  summary: item.data.summary
}));
const faqEntities = service.data.faq.filter((item) => item.question.trim() && item.answer.trim());

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: service.data.title,
    description: service.data.seoDescription,
    url: canonical,
    provider: { "@type": "Organization", name: site.name, url: site.url },
    areaServed: "RU"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Главная", item: new URL(withBase("/"), origin).href },
      { "@type": "ListItem", position: 2, name: "Услуги", item: new URL(withBase("/uslugi"), origin).href },
      { "@type": "ListItem", position: 3, name: service.data.title, item: canonical }
    ]
  },
  ...(faqEntities.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faqEntities.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: { "@type": "Answer", text: item.answer }
          }))
        }
      ]
    : [])
];
---

<BaseLayout description={service.data.seoDescription} jsonLd={jsonLd} title={service.data.seoTitle}>
  <ServicePage
    contact={home.contact}
    metrikaId={metrikaId(site)}
    service={service.data}
    services={related}
    site={site}
    tariffs={tariffs}
  >
    <Content />
  </ServicePage>
</BaseLayout>
