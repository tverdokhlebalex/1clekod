---
import { ArrowRight, Check } from "lucide-react";
import ContactSection from "@/components/sections/ContactSection.astro";
import { BentoVisual } from "@/components/islands/BentoVisual";
import { HeroPanel } from "@/components/islands/HeroPanel";
import { IntegrationMap } from "@/components/islands/IntegrationMap";
import { ProcessTimeline } from "@/components/islands/ProcessTimeline";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { Icon } from "@/components/ui/Icon";
import { getCases, getFaq, getHome, getServices, getSite, getTariffs, metrikaId } from "@/lib/content";
import { withBase } from "@/lib/path";
import "@/styles/home-design.css";

const home = getHome();
const site = getSite();
const services = await getServices();
const cases = await getCases();
const faq = getFaq();
const tariffs = getTariffs();
const counter = metrikaId(site);
const primary = services.filter((item) => item.data.group === "primary" && item.data.featuredOnHome);
const related = services.filter((item) => item.data.group === "related" && item.data.featuredOnHome);
const serviceOptions = services.map((item) => ({ slug: item.data.slug, name: item.data.title }));

const visuals = {
  "soprovozhdenie-1s": "queue",
  "obmeny-1s": "exchange",
  "integraciya-1s-bitriks24": "deal",
  "audit-1s": "audit",
  "srochnaya-pomoshch-1s": "urgent"
} as const;
---

<section class="home-hero">
  <Container class="home-hero__layout">
    <div class="home-hero__copy">
      <Badge tone="light">{home.hero.eyebrow}</Badge>
      <h1 class="home-hero__title">
        {home.hero.titleBefore}<span>{home.hero.titleAccent}</span>{home.hero.titleAfter}
      </h1>
      <p class="home-hero__description">{home.hero.description}</p>
      <div class="home-hero__actions">
        <Button href={home.hero.primaryButton.href} size="lg">
          {home.hero.primaryButton.label}
          <ArrowRight aria-hidden size={18} />
        </Button>
        <Button href={home.hero.secondaryButton.href} size="lg" variant="secondary">{home.hero.secondaryButton.label}</Button>
      </div>
      <dl class="home-hero__proof">
        {
          home.hero.stats.map((stat) => (
            <div>
              <dt class="text-sm leading-5 text-[var(--color-muted)]">{stat.label}</dt>
              <dd class="mt-1 text-lg font-semibold tracking-tight">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <HeroPanel panel={home.hero.panel} />
  </Container>
</section>

<Section description={home.problems.description} eyebrow={home.problems.eyebrow} title={home.problems.title}>
  <div class="grid gap-8 md:grid-cols-3">
    {
      home.problems.items.map((item) => (
        <article class="border-t-2 border-[var(--color-ink)] pt-5">
          <h3 class="text-xl font-semibold">{item.title}</h3>
          <p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">{item.text}</p>
        </article>
      ))
    }
  </div>
</Section>

<Section description={home.areas.description} eyebrow={home.areas.eyebrow} title={home.areas.title} tone="white">
  <div class="grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      home.areas.items.map((item) => (
        <div class="flex gap-3">
          <span class="mt-0.5 grid size-9 shrink-0 place-items-center rounded-[var(--radius-sm)] bg-[#111827] text-[#ffd43b]">
            <Icon name={item.icon} size={18} />
          </span>
          <div>
            <h3 class="font-semibold">{item.title}</h3>
            <p class="mt-1 text-sm leading-6 text-[var(--color-muted)]">{item.text}</p>
          </div>
        </div>
      ))
    }
  </div>
</Section>

<Section description={home.services.description} eyebrow={home.services.eyebrow} id="uslugi" title={home.services.title}>
  <div class="home-services">
    {
      primary.map((item) => {
        const kind = visuals[item.data.slug as keyof typeof visuals];
        return (
          <a class:list={["home-service", `home-service--${kind ?? "default"}`]} data-layout={item.data.layout} href={withBase(`/uslugi/${item.data.slug}`)}>
              <div class="home-service__copy">
                <span class="home-service__tag">{item.data.tag}</span>
                <h3>{item.data.title}</h3>
                <p class="home-service__summary">{item.data.summary}</p>
                <p class="home-service__outcome">{item.data.outcome}</p>
                <span class="home-service__link">
                  Подробнее <ArrowRight aria-hidden size={16} />
                </span>
              </div>
              {kind && (
                <div class="home-service__visual">
                  <BentoVisual kind={kind} />
                </div>
              )}
          </a>
        );
      })
    }
  </div>
</Section>

<Section description={home.integrations.description} eyebrow={home.integrations.eyebrow} id="svyazki" title={home.integrations.title} tone="dark">
  <div class="pointer-events-none absolute left-1/2 top-24 h-64 w-64 -translate-x-1/2 rounded-full bg-[rgb(77_107_255_/_0.18)] blur-3xl"></div>
  <div class="pointer-events-none absolute right-10 top-16 h-40 w-40 rounded-full bg-[rgb(255_212_59_/_0.16)] blur-3xl"></div>
  <IntegrationMap client:visible items={home.integrations.items} />
</Section>

<Section description={home.process.description} eyebrow={home.process.eyebrow} id="kak-rabotaem" title={home.process.title} tone="white">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,300px)_1fr] lg:gap-14">
    <div>
      <Card class="lg:sticky lg:top-24" interactive={false} tone="featured">
        <Badge>{home.process.sideBadge}</Badge>
        <h3 class="mt-4 text-2xl font-semibold">{home.process.sideTitle}</h3>
        <p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">{home.process.sideText}</p>
        <p class="mt-6 rounded-[var(--radius-md)] bg-[var(--color-page)] px-4 py-3 text-sm">{home.process.sideNote}</p>
        <Button class="mt-6" href={home.process.button.href}>{home.process.button.label}</Button>
      </Card>
    </div>
    <ProcessTimeline client:visible steps={home.process.steps} />
  </div>
</Section>

<Section description={home.tariffs.description} eyebrow={home.tariffs.eyebrow} id="tarify" title={home.tariffs.title}>
  <div class="home-tariffs">
    {
      tariffs.map((item) => (
        <article class:list={["home-tariff", item.accent && "home-tariff--lead"]}>
          {item.accent && <p class="home-tariff__badge">Основной формат</p>}
          <h3>{item.name}</h3>
          <p class="home-tariff__price">{item.price || item.priceLabel}</p>
          <p class="home-tariff__desc">{item.description}</p>
          {
            item.hourPacks.length > 0 && (
              <ul class="home-tariff__packs">
                {item.hourPacks.map((pack) => (
                  <li>{pack}</li>
                ))}
              </ul>
            )
          }
          <ul class="home-tariff__features">
            {item.features.map((feature) => (
              <li>
                <Check aria-hidden className="home-tariff__check" size={18} />
                <span>{feature}</span>
              </li>
            ))}
          </ul>
          <p class="home-tariff__note">{item.priceNote}</p>
          <Button class="home-tariff__cta" href={item.button.href} variant={item.accent ? "primary" : "secondary"}>
            {item.button.label}
          </Button>
        </article>
      ))
    }
  </div>
</Section>

<Section description={home.tasks.description} eyebrow={home.tasks.eyebrow} title={home.tasks.title} tone="white">
  <ul class="grid gap-x-10 md:grid-cols-2">
    {
      home.tasks.items.map((task, index) => (
        <li class="flex gap-4 border-t border-[var(--color-line)] py-4 text-sm leading-6">
          <span class="font-semibold text-[var(--color-gold-deep)]">{String(index + 1).padStart(2, "0")}</span>
          <span>{task}</span>
        </li>
      ))
    }
  </ul>
</Section>

<Section description={home.reasons.description} eyebrow={home.reasons.eyebrow} id="pochemu-my" title={home.reasons.title} tone="dark">
  <div class="home-why">
    {
      home.reasons.items.map((item, index) => (
        <article class={`home-why__item home-why__item--${item.icon}`}>
          <p class="home-why__index">{String(index + 1).padStart(2, "0")}</p>
          <h3>{item.title}</h3>
          <p class="home-why__text">{item.text}</p>
          <div aria-hidden="true" class="home-why__viz">
            {item.icon === "users" && (
              <div class="home-why__nodes">
                <span>1С</span>
                <i></i>
                <span>CRM</span>
                <i></i>
                <span>Сайт</span>
              </div>
            )}
            {item.icon === "badge" && (
              <div class="home-why__layers">
                <span></span>
                <span></span>
                <span></span>
              </div>
            )}
            {item.icon === "shield" && (
              <div class="home-why__path">
                <span>Копия</span>
                <i></i>
                <span>Проверка</span>
                <i></i>
                <span>База</span>
              </div>
            )}
            {item.icon === "gauge" && (
              <div class="home-why__hours">
                <span>10</span>
                <span>20</span>
                <span>40</span>
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Section>

{
  related.length > 0 && (
    <Section description={home.related.description} eyebrow={home.related.eyebrow} id="smezhnye" title={home.related.title}>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {related.map((item) => (
          <a class="group rounded-[var(--radius-lg)] border border-[var(--color-line)] bg-white p-5 transition hover:-translate-y-1 hover:border-[var(--color-amber)] hover:shadow-[var(--shadow-glow)] motion-reduce:hover:translate-y-0" href={withBase(`/uslugi/${item.data.slug}`)}>
            <h3 class="text-lg font-semibold">{item.data.title}</h3>
            <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">{item.data.summary}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-gold-deep)]">
              Открыть <ArrowRight aria-hidden size={16} />
            </span>
          </a>
        ))}
      </div>
    </Section>
  )
}

{
  cases.length > 0 && (
    <Section description={home.cases.description} eyebrow={home.cases.eyebrow} id="keisy" title={home.cases.title} tone="white">
      <div class="grid gap-5 lg:grid-cols-3">
        {cases.slice(0, 3).map((item) => (
          <Card class="flex h-full flex-col" href={`/keisy/${item.data.slug}`}>
            <Badge>{item.data.industry}</Badge>
            <h3 class="mt-4 text-xl font-semibold">{item.data.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-6 text-[var(--color-muted)]">{item.data.summary}</p>
            <p class="mt-4 text-sm font-medium text-[var(--color-gold-deep)]">{item.data.result}</p>
          </Card>
        ))}
      </div>
      <div class="mt-8">
        <Button href={home.cases.button.href} variant="secondary">{home.cases.button.label}</Button>
      </div>
    </Section>
  )
}

<section class="home-faq" id="faq" aria-labelledby="home-faq-title">
  <Container class="home-faq__layout">
    <div class="home-faq__intro">
      <Badge>{home.faq.eyebrow}</Badge>
      <h2 id="home-faq-title">{home.faq.title}</h2>
      <p>{home.faq.description}</p>
    </div>
    <div class="home-faq__list">
    {
      faq.map((item) => (
        <details class="home-faq__item">
          <summary>
            <span>{item.question}</span>
            <span class="home-faq__toggle" aria-hidden="true"></span>
          </summary>
          <div class="home-faq__answer"><p>{item.answer}</p></div>
        </details>
      ))
    }
    </div>
  </Container>
</section>

<section class="home-cta" aria-labelledby="home-cta-title">
  <Container class="home-cta__layout">
    <h2 id="home-cta-title">{home.cta.title}</h2>
    <div class="home-cta__body">
      <p>{home.cta.description}</p>
      <div class="home-cta__actions">
        <Button href={home.cta.primaryButton.href} size="lg">
          {home.cta.primaryButton.label}<ArrowRight aria-hidden size={18} />
        </Button>
        <Button href={home.cta.secondaryButton.href} size="lg" variant="glass">
          {home.cta.secondaryButton.label}
        </Button>
      </div>
    </div>
  </Container>
</section>

<ContactSection class="home-contact" contact={home.contact} metrikaId={counter} services={serviceOptions} site={site} tariffs={tariffs} />
