---
type Lane = { from: string; label: string; to: string };

type Props = {
  slug: string;
  mode?: "compact" | "wide";
  note?: string;
};

const exchangeLanes: Lane[] = [
  { from: "Сайт", label: "Заказы", to: "1С" },
  { from: "1С", label: "Остатки и цены", to: "Сайт" },
  { from: "База торговли", label: "Контрагенты", to: "Бухгалтерия" },
  { from: "Журнал обмена", label: "Ошибка, а не тишина", to: "Разбор" }
];

const bitrixLanes: Lane[] = [
  { from: "Сделка в Битрикс24", label: "Заказ", to: "1С" },
  { from: "1С", label: "Счёт и оплата", to: "Статус сделки" },
  { from: "1С", label: "Товары и остатки", to: "Битрикс24" },
  { from: "Контрагент", label: "Одна карточка", to: "Сторону согласуем" }
];

const captions: Record<string, string> = {
  "obmeny-1s": "У каждого потока своё направление. Заказы, остатки, цены и контрагенты не едут одним правилом.",
  "integraciya-1s-bitriks24": "В обмен попадает согласованный состав. Не каждый справочник нужно синхронизировать в обе стороны."
};

const { slug, mode = "compact", note = "" } = Astro.props;
const lanes = slug === "integraciya-1s-bitriks24" ? bitrixLanes : exchangeLanes;
const caption = note.trim() || captions[slug] || "";
const diagram = slug === "obmeny-1s" || slug === "integraciya-1s-bitriks24";
---

{
  mode === "wide" && diagram && (
    <figure class="overflow-hidden rounded-[var(--radius-xl)] border border-white/10 bg-[#111827] p-4 text-white shadow-[var(--shadow-lg)] sm:p-6">
      <ul class="grid gap-3">
        {lanes.map((lane) => (
          <li class="grid items-center gap-3 rounded-2xl bg-white/5 px-4 py-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)_minmax(0,1fr)]">
            <p class="min-w-0 text-sm font-semibold">{lane.from}</p>
            <div class="min-w-0">
              <p class="mb-2 text-center text-sm font-semibold text-[#ffd43b]">
                {lane.label}
                <span class="sr-only">, направление: {lane.from} → {lane.to}</span>
              </p>
              <div class="relative h-1.5 overflow-hidden rounded-full bg-white/10" style="container-type: inline-size">
                <span class="packet absolute top-0 left-0 size-1.5 rounded-full bg-[#4d6bff] shadow-[0_0_10px_#4d6bff]" />
              </div>
              <p aria-hidden="true" class="mt-1 text-center text-xs font-semibold text-[#4d6bff]">
                <span class="sm:hidden">↓</span>
                <span class="hidden sm:inline">→</span>
              </p>
            </div>
            <p class="min-w-0 text-sm font-semibold sm:text-right">{lane.to}</p>
          </li>
        ))}
      </ul>
      {caption && <figcaption class="mt-4 max-w-3xl text-sm leading-6 text-white/75">{caption}</figcaption>}
    </figure>
  )
}

{
  mode === "compact" && (
    <div aria-hidden="true" class="overflow-hidden rounded-[var(--radius-xl)] border border-white/10 bg-[#111827] p-4 text-white shadow-[var(--shadow-lg)] sm:p-5">
      {slug === "soprovozhdenie-1s" && (
        <div>
          <div class="flex items-center justify-between gap-3">
            <p class="text-sm font-semibold">Очередь базы</p>
            <p class="text-xs text-white/50">пример</p>
          </div>
          <ul class="mt-4 grid gap-2">
            {[
              ["Проведение реализации", "в работе", true],
              ["Отчёт по менеджерам", "в очереди", false],
              ["Обновление нетиповой УТ", "копия", false],
              ["Печатная форма счёта", "готово", false]
            ].map(([label, status, active]) => (
              <li class="flex items-center justify-between gap-3 rounded-xl bg-white/5 px-3 py-2.5">
                <span class="min-w-0 truncate text-sm">{label}</span>
                <span class:list={["shrink-0 rounded-full px-2 py-0.5 text-xs font-semibold", active ? "bg-[#ffd43b] text-[#111827]" : "bg-white/10 text-white/80"]}>
                  {status}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {slug === "obmeny-1s" && (
        <div>
          <div class="flex items-center justify-between gap-3">
            <p class="text-sm font-semibold">Потоки обмена</p>
            <p class="text-xs text-white/50">пример</p>
          </div>
          <ul class="mt-4 grid gap-3">
            {exchangeLanes.slice(0, 3).map((lane) => (
              <li class="rounded-xl bg-white/5 px-3 py-3">
                <p class="text-center text-xs font-semibold text-[#ffd43b]">{lane.label}</p>
                <p class="mt-1 text-center text-sm">
                  {lane.from} <span class="text-[#4d6bff]">→</span> {lane.to}
                </p>
              </li>
            ))}
          </ul>
        </div>
      )}

      {slug === "audit-1s" && (
        <div>
          <div class="flex items-center justify-between gap-3">
            <p class="text-sm font-semibold">Карта базы</p>
            <p class="text-xs text-white/50">пример</p>
          </div>
          <ul class="mt-4 grid gap-2">
            {[
              ["Состояние базы", "смотрим"],
              ["Расширения", "есть риск"],
              ["Скорость отчёта", "смотрим"],
              ["Обмены", "без журнала"],
              ["План правок", "на выходе"]
            ].map(([label, status]) => (
              <li class="flex items-center justify-between gap-3 rounded-xl bg-white/5 px-3 py-2.5">
                <span class="min-w-0 text-sm">{label}</span>
                <span class="shrink-0 text-xs font-semibold text-[#ffd43b]">{status}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {slug === "integraciya-1s-bitriks24" && (
        <div>
          <div class="flex items-center justify-between gap-3">
            <p class="text-sm font-semibold">1С и Битрикс24</p>
            <p class="text-xs text-white/50">пример</p>
          </div>
          <div class="mt-4 grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2">
            <div class="rounded-xl bg-white/5 p-3 text-center">
              <p class="text-xs text-white/50">учёт</p>
              <p class="mt-1 text-sm font-semibold">1С</p>
            </div>
            <div class="grid justify-items-center gap-1 text-center text-xs font-semibold leading-tight text-white">
              <span>← сделка</span>
              <span>оплата →</span>
            </div>
            <div class="rounded-xl bg-white/5 p-3 text-center">
              <p class="text-xs text-white/50">продажи</p>
              <p class="mt-1 text-sm font-semibold">Битрикс24</p>
            </div>
          </div>
          <ul class="mt-3 grid gap-2 text-sm">
            <li class="rounded-xl bg-white/5 px-3 py-2">Сделка → заказ</li>
            <li class="rounded-xl bg-white/5 px-3 py-2">Оплата → статус сделки</li>
            <li class="rounded-xl bg-[#ffd43b] px-3 py-2 font-semibold text-[#111827]">Не всё в обе стороны</li>
          </ul>
        </div>
      )}

      {slug === "srochnaya-pomoshch-1s" && (
        <div>
          <div class="flex items-center justify-between gap-3">
            <p class="text-sm font-semibold">Рабочая база</p>
            <p class="text-xs text-white/50">пример</p>
          </div>
          <div class="mt-4 rounded-xl border border-[#ffd43b]/40 bg-white/5 p-4">
            <p class="text-xs font-semibold text-[#ffd43b]">Документ не проводится</p>
            <p class="mt-2 text-sm leading-6 text-white/80">Реализация зависла после обновления. Обмен с сайтом в этот момент тоже молчит.</p>
          </div>
          <p class="mt-3 rounded-xl bg-white/5 px-3 py-2.5 text-sm">Сначала симптом, потом узкая правка</p>
        </div>
      )}

      {slug !== "soprovozhdenie-1s" && slug !== "obmeny-1s" && slug !== "audit-1s" && slug !== "integraciya-1s-bitriks24" && slug !== "srochnaya-pomoshch-1s" && (
        <div>
          <div class="flex items-center justify-between gap-3">
            <p class="text-sm font-semibold">Контур задачи</p>
            <p class="text-xs text-white/50">пример</p>
          </div>
          <ul class="mt-4 grid gap-2">
            {["База", "Задача", "Проверка"].map((label) => (
              <li class="rounded-xl bg-white/5 px-3 py-2.5 text-sm">{label}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )
}
