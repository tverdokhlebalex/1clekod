---
import ServiceVisual from "@/components/sections/ServiceVisual.astro";
import ContactSection from "@/components/sections/ContactSection.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import type { HomeContent, ServiceContent, SiteContent, Tariff } from "@/lib/schema";
import { withBase } from "@/lib/path";

type Related = { slug: string; title: string; outcome: string; summary: string };

type Props = {
  service: ServiceContent;
  services: Related[];
  site: SiteContent;
  contact: HomeContent["contact"];
  tariffs: Tariff[];
  metrikaId: string;
};

const { service, services, site, contact, tariffs, metrikaId } = Astro.props;

function heading(value: string, fallback: string) {
  return value.trim() || fallback;
}

function filled<T extends { title: string; text: string }>(items: T[]) {
  return items.filter((item) => item.title.trim() || item.text.trim());
}

const problems = filled(service.problems);
const works = filled(service.works);
const results = filled(service.benefits);
const steps = service.steps.filter((step) => step.title.trim() || step.text.trim());
const faqs = service.faq.filter((item) => item.question.trim() && item.answer.trim());
const formatItems = service.formats
  .map((slug) => tariffs.find((tariff) => tariff.slug === slug))
  .filter((tariff): tariff is Tariff => Boolean(tariff));
const picked = service.related
  .map((slug) => services.find((item) => item.slug === slug))
  .filter((item): item is Related => Boolean(item));
const related = picked.length > 0 ? picked : services.filter((item) => item.slug !== service.slug).slice(0, 3);
const diagramTitles: Record<string, string> = {
  "obmeny-1s": "Как ходят данные",
  "integraciya-1s-bitriks24": "Что связываем между 1С и Битрикс24",
  "integraciya-1s-marketpleysy": "Как площадки сходятся в 1С"
};
const diagramFallback = diagramTitles[service.slug];
const formatsNote = service.formatsNote.trim();
const showFormats = formatItems.length > 0 || Boolean(formatsNote);
const h1 = heading(service.heroTitle, service.title);
---

<main id="main-content">
  <section class="relative overflow-x-clip bg-hero">
    <div class="pointer-events-none absolute -right-16 top-8 h-56 w-56 rounded-full bg-[rgb(255_212_59_/_0.28)] blur-3xl"></div>
    <Container class="py-10 sm:py-14">
      <p class="text-sm text-[var(--color-muted)]">
        <a class="hover:text-[var(--color-gold-deep)]" href={withBase("/")}>Главная</a>
        <span aria-hidden="true"> / </span>
        <a class="hover:text-[var(--color-gold-deep)]" href={withBase("/uslugi")}>Услуги</a>
        <span aria-hidden="true"> / </span>
        <span>{service.title}</span>
      </p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-[minmax(0,1.08fr)_minmax(16rem,0.92fr)] lg:gap-12">
        <div class="min-w-0">
          {service.tag.trim() && <Badge>{service.tag}</Badge>}
          <h1 class="mt-4 max-w-3xl text-balance text-4xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-5xl">{h1}</h1>
          {
            service.heroLead.trim() && (
              <p class="mt-5 max-w-2xl text-pretty text-lg leading-8 text-[var(--color-muted)]">{service.heroLead}</p>
            )
          }
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            {
              service.primaryButton.label.trim() && (
                <Button class="w-full sm:w-auto" href={service.primaryButton.href || "#kontakty"} size="lg">
                  {service.primaryButton.label}
                </Button>
              )
            }
            {
              service.secondaryButton.label.trim() && (
                <Button class="w-full sm:w-auto" href={service.secondaryButton.href || "/uslugi"} size="lg" variant="secondary">
                  {service.secondaryButton.label}
                </Button>
              )
            }
          </div>
        </div>
        <ServiceVisual slug={service.slug} />
      </div>
    </Container>
  </section>

  {
    problems.length > 0 && (
      <Section id="problemy" title={heading(service.problemsTitle, "С чем приходят")} tone="dark">
        <ol class="grid gap-8 sm:grid-cols-2">
          {problems.map((item, index) => (
            <li class="min-w-0 border-t border-white/15 pt-4">
              <p class="text-sm font-semibold text-[#ffd43b]">{String(index + 1).padStart(2, "0")}</p>
              {item.title && <h3 class="mt-2 text-xl font-semibold text-white">{item.title}</h3>}
              {item.text && <p class="mt-2 text-sm leading-6 text-white/75">{item.text}</p>}
            </li>
          ))}
        </ol>
      </Section>
    )
  }

  {
    diagramFallback && (
      <Section id="shema" title={heading(service.diagramTitle, diagramFallback)}>
        <ServiceVisual mode="wide" note={service.diagramNote} slug={service.slug} />
      </Section>
    )
  }

  {
    works.length > 0 && (
      <Section id="sostav" title={heading(service.worksTitle, "Что делаем")}>
        <div class="divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
          {works.map((item) => (
            <div class="grid gap-2 py-6 sm:grid-cols-[minmax(0,16rem)_minmax(0,1fr)] sm:gap-10">
              {item.title && <h3 class="text-lg font-semibold">{item.title}</h3>}
              {item.text && <p class="max-w-[68ch] text-sm leading-6 text-[var(--color-muted)]">{item.text}</p>}
            </div>
          ))}
        </div>
      </Section>
    )
  }

  {
    results.length > 0 && (
      <Section id="rezultat" title={heading(service.resultsTitle, "Что меняется после работы")} tone="white">
        <ul class="grid gap-x-10 gap-y-6 md:grid-cols-2">
          {results.map((item) => (
            <li class="flex min-w-0 gap-3">
              <span aria-hidden="true" class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full bg-[#ffd43b] text-sm font-bold text-[#111827]">
                ✓
              </span>
              <div class="min-w-0">
                {item.title && <h3 class="text-lg font-semibold">{item.title}</h3>}
                {item.text && <p class="mt-1 text-sm leading-6 text-[var(--color-muted)]">{item.text}</p>}
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-8 text-sm leading-6 text-[var(--color-muted)]">
          <a class="font-semibold text-[var(--color-gold-deep)] underline decoration-[var(--color-amber)] underline-offset-4" href="#kontakty">
            Опишите задачу
          </a>
          <span> — базу, ошибку или обмен. Форма ниже сохранит выбранную услугу.</span>
        </p>
      </Section>
    )
  }

  {
    Astro.slots.has("default") && (
      <Section class="py-8 sm:py-10 lg:py-12">
        <article class="richtext max-w-3xl">
          <slot />
        </article>
      </Section>
    )
  }

  {
    steps.length > 0 && (
      <Section id="hod" title={heading(service.stepsTitle, "Как проходит работа")} tone="white">
        <ol class="grid gap-8">
          {steps.map((step, index) => (
            <li class="grid gap-4 border-t border-[var(--color-line)] pt-6 lg:grid-cols-[4.5rem_minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-8">
              <p class="text-3xl font-semibold tracking-tight text-[var(--color-gold-deep)]">{String(index + 1).padStart(2, "0")}</p>
              <div class="min-w-0">
                {step.title && <h3 class="text-xl font-semibold">{step.title}</h3>}
                {step.text && <p class="mt-2 max-w-[62ch] text-sm leading-6 text-[var(--color-muted)]">{step.text}</p>}
              </div>
              {(step.client.trim() || step.deliverable.trim()) && (
                <div class="grid content-start gap-3 text-sm leading-6">
                  {step.client.trim() && (
                    <p>
                      <span class="font-semibold text-[var(--color-ink)]">От клиента. </span>
                      <span class="text-[var(--color-muted)]">{step.client}</span>
                    </p>
                  )}
                  {step.deliverable.trim() && (
                    <p>
                      <span class="font-semibold text-[var(--color-ink)]">Передаём. </span>
                      <span class="text-[var(--color-muted)]">{step.deliverable}</span>
                    </p>
                  )}
                </div>
              )}
            </li>
          ))}
        </ol>
      </Section>
    )
  }

  {
    showFormats && (
      <Section id="formaty" description={formatsNote || undefined} title={heading(service.formatsTitle, "Как можно работать")}>
        {formatItems.length > 0 && (
          <div class:list={["grid gap-4", formatItems.length > 1 && "md:grid-cols-2", formatItems.length > 2 && "xl:grid-cols-3"]}>
            {formatItems.map((tariff) => (
              <article class="flex h-full min-w-0 flex-col rounded-[var(--radius-lg)] border border-[var(--color-line)] bg-[var(--color-page)] p-5">
                <h3 class="text-xl font-semibold">{tariff.name}</h3>
                <p class="mt-2 text-sm font-semibold text-[var(--color-gold-deep)]">{tariff.priceLabel}</p>
                {tariff.description && <p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">{tariff.description}</p>}
                {tariff.hourPacks.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {tariff.hourPacks.map((pack) => (
                      <li class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-[var(--color-ink)]">{pack}</li>
                    ))}
                  </ul>
                )}
                <a class="mt-5 inline-flex font-semibold text-[var(--color-gold-deep)]" href={`?format=${tariff.slug}#kontakty`}>
                  Выбрать этот формат
                </a>
              </article>
            ))}
          </div>
        )}
      </Section>
    )
  }

  {
    faqs.length > 0 && (
      <Section id="voprosy" title={heading(service.faqTitle, "Вопросы по услуге")} tone="white">
        <div class="max-w-3xl divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
          {faqs.map((item) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold focus-visible:outline-none focus-visible:shadow-[var(--shadow-focus)] [&::-webkit-details-marker]:hidden">
                <span>{item.question}</span>
                <span aria-hidden="true" class="mt-0.5 text-xl leading-none text-[var(--color-gold-deep)] transition group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-3 max-w-[68ch] text-sm leading-6 text-[var(--color-muted)]">{item.answer}</p>
            </details>
          ))}
        </div>
      </Section>
    )
  }

  {
    related.length > 0 && (
      <Section id="smezhnye" title={heading(service.relatedTitle, "Смежные задачи")} tone="dark">
        <ul class="divide-y divide-white/15 border-y border-white/15">
          {related.map((item) => (
            <li class="grid gap-2 py-5 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] sm:items-baseline sm:gap-8">
              <h3 class="text-lg font-semibold">
                <a class="underline decoration-white/30 underline-offset-4 hover:decoration-[#ffd43b]" href={withBase(`/uslugi/${item.slug}`)}>
                  {item.title}
                </a>
              </h3>
              <p class="text-sm leading-6 text-white/75">{item.outcome || item.summary}</p>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <ContactSection
    contact={contact}
    defaultService={service.title}
    metrikaId={metrikaId}
    services={services.map((item) => ({ slug: item.slug, name: item.title }))}
    site={site}
    tariffs={tariffs}
  />
</main>
