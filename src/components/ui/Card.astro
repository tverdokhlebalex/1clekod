---
import { cn } from "@/lib/cn";
import { withBase } from "@/lib/path";

type Props = {
  tone?: "default" | "soft" | "accent" | "featured" | "inverse";
  interactive?: boolean;
  class?: string;
  href?: string;
};

const { tone = "default", interactive = true, class: className, href } = Astro.props;
const link = href ? withBase(href) : undefined;
const tones = {
  default: "border-[var(--color-line)] bg-white",
  soft: "border-[var(--color-line)] bg-[var(--color-page)]",
  accent: "border-[rgb(245_184_0_/_0.4)] bg-[var(--color-gold-soft)]",
  featured: "card-gradient-border shadow-[var(--shadow-glow)]",
  inverse: "border-white/10 bg-[#111827] text-white shadow-[var(--shadow-lg)]"
};
const classes = cn(
  "rounded-[var(--radius-lg)] border p-6 shadow-[var(--shadow-sm)] transition duration-300",
  tones[tone],
  interactive && tone !== "inverse" && "hover:-translate-y-1 hover:border-[var(--color-amber)] hover:shadow-[var(--shadow-glow)] motion-reduce:hover:translate-y-0",
  interactive && tone === "inverse" && "hover:-translate-y-1 hover:border-[#ffd43b]/70 motion-reduce:hover:translate-y-0",
  className
);
---

{
  href ? (
    <a class:list={[classes, "block h-full"]} href={link}>
      <slot />
    </a>
  ) : (
    <div class={classes}>
      <slot />
    </div>
  )
}
