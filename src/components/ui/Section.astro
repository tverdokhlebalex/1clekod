---
import Badge from "./Badge.astro";
import Container from "./Container.astro";
import { cn } from "@/lib/cn";

type Props = {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  align?: "left" | "center";
  tone?: "default" | "soft" | "white" | "dark";
  class?: string;
};

const { id, eyebrow, title, description, align = "left", tone = "default", class: className } = Astro.props;
const dark = tone === "dark";
const tones = {
  default: "bg-[var(--color-page)]",
  soft: "bg-white",
  white: "bg-white",
  dark: "bg-[#111827] text-white"
};
---

<section class={cn("relative isolate overflow-x-clip scroll-mt-24 py-14 sm:py-16 lg:py-20", tones[tone], className)} id={id}>
  <Container>
    {
      (eyebrow || title || description) && (
        <div class:list={["mb-8 max-w-3xl sm:mb-10", align === "center" && "mx-auto text-center"]}>
          {eyebrow && (dark ? <p class="text-sm font-semibold text-[#ffd43b]">{eyebrow}</p> : <Badge>{eyebrow}</Badge>)}
          {title && (
            <h2 class:list={["mt-3 text-balance text-3xl font-semibold tracking-tight sm:text-4xl", dark ? "text-white" : "text-[var(--color-ink)]"]}>
              {title}
            </h2>
          )}
          {description && (
            <p class:list={["mt-4 max-w-[68ch] text-pretty text-base leading-7 sm:text-lg", dark ? "text-white/75" : "text-[var(--color-muted)]", align === "center" && "mx-auto"]}>
              {description}
            </p>
          )}
        </div>
      )
    }
    <slot />
  </Container>
</section>
