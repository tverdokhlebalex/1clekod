---
import { LogoMark } from "@/components/ui/LogoMark";
import { getSite } from "@/lib/content";
import { withBase } from "@/lib/path";

const site = getSite();
const year = new Date().getFullYear();
const requisites = [site.legalName, site.inn && `ИНН ${site.inn}`, site.ogrn && `ОГРН ${site.ogrn}`].filter(Boolean);
---

<footer class="border-t border-[var(--color-line)] bg-white">
  <div class="mx-auto grid w-full max-w-7xl gap-10 px-4 py-10 sm:px-6 md:grid-cols-[1.2fr_0.8fr_1fr] lg:px-8">
    <div>
      <a class="inline-flex items-center gap-2.5 text-lg font-semibold tracking-tight" href={withBase("/")}>
        {site.logo ? <img alt="" class="size-9 shrink-0 rounded-[8px] object-contain" src={withBase(site.logo)} /> : <LogoMark />}
        {site.name}
      </a>
      <p class="mt-1 text-sm text-[var(--color-muted)]">{site.tagline}</p>
      <p class="mt-4 max-w-sm text-sm leading-6 text-[var(--color-muted)]">{site.footerText}</p>
      <div class="mt-6 grid gap-2 text-sm">
        {
          site.phones.map((phone) => (
            <a class="hover:text-[var(--color-gold-deep)]" href={withBase(phone.href)}>
              {phone.label}: {phone.display}
            </a>
          ))
        }
        {
          site.messengers.map((item) => (
            <a class="hover:text-[var(--color-gold-deep)]" href={withBase(item.href)}>
              {item.label}: {item.display}
            </a>
          ))
        }
        <a class="hover:text-[var(--color-gold-deep)]" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      {requisites.length > 0 && <p class="mt-4 text-sm leading-6 text-[var(--color-muted)]">{requisites.join(", ")}</p>}
    </div>
    <div>
      <h2 class="text-sm font-semibold">Разделы</h2>
      <div class="mt-4 grid gap-3 text-sm">
        {
          site.nav.map((item) => (
            <a class="text-[var(--color-muted)] hover:text-[var(--color-gold-deep)]" href={withBase(item.href)}>
              {item.label}
            </a>
          ))
        }
        <a class="text-[var(--color-muted)] hover:text-[var(--color-gold-deep)]" href={withBase("/uslugi")}>Все услуги</a>
        <a class="text-[var(--color-muted)] hover:text-[var(--color-gold-deep)]" href={withBase("/keisy")}>Сценарии</a>
      </div>
    </div>
    <div>
      <h2 class="text-sm font-semibold">Документы</h2>
      <div class="mt-4 grid gap-3 text-sm">
        <a class="text-[var(--color-muted)] hover:text-[var(--color-gold-deep)]" href={withBase("/privacy")}>Политика обработки персональных данных</a>
        <a class="text-[var(--color-muted)] hover:text-[var(--color-gold-deep)]" href={withBase("/consent")}>Согласие на обработку персональных данных</a>
        <a class="text-[var(--color-muted)] hover:text-[var(--color-gold-deep)]" href={withBase("/cookies")}>Cookies</a>
      </div>
      <div class="mt-6 grid gap-2 text-sm text-[var(--color-muted)]">
        {site.addresses.map((address) => <p>{address.label}: {address.value}</p>)}
      </div>
    </div>
  </div>
  <div class="border-t border-[var(--color-line)]">
    <div class="mx-auto w-full max-w-7xl px-4 py-5 text-sm text-[var(--color-subtle)] sm:px-6 lg:px-8">
      © {year} {site.legalName || site.name}. Все права защищены.
    </div>
  </div>
</footer>
